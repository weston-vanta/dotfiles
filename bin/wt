#!/usr/bin/env python3
"""wt: cheap, fast git worktrees via overlayfs.

One fully warmed checkout of the default branch (the base) is the read-only
lower layer. Each worktree is an overlay mount over it with its own upper
directory, so a worktree costs only the files its branch changes or rebuilds.

Layout, one sibling directory per repo:
  <repo>/                 main checkout, never touched
  <repo>.wt/<branch>      mount point handed to agents (nested for a/b names)
  <repo>.wt/.base         base: detached git worktree at a default-branch commit
  <repo>.wt/.state/<branch>/{upper,work}

The repo is resolved from the current directory (or --repo), including from
inside a worktree or the base. State is derived from the filesystem and git;
there is no registry file. Per-repo settings live in git config:
  wt.warm       command(s) run in the base after checkout (multi-valued, via sh -c)
  wt.baseRef    ref the base tracks (default: origin's HEAD, e.g. origin/main)
  wt.cachePath  path(s) whose size `wt status` reports (multi-valued)
  wt.stateDir   where upper/work dirs live (default <repo>.wt/.state). Must be on a
                filesystem overlayfs accepts as upperdir: not itself an overlay, which
                a container's root filesystem usually is.

Requires Linux with passwordless sudo for mount/umount.
"""

from __future__ import annotations

import argparse
import contextlib
import json
import os
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path

STALE_BASE_SECONDS = 24 * 3600
REMOTE = "origin"


class WtError(Exception):
    pass


# --------------------------------------------------------------------------- pure


@dataclass(frozen=True)
class Repo:
    root: Path
    warm: list[str] = field(default_factory=list)
    base_ref: str = ""
    cache_paths: list[Path] = field(default_factory=list)
    state_dir: Path | None = None

    @property
    def wt_dir(self) -> Path:
        return self.root.parent / f"{self.root.name}.wt"

    @property
    def base(self) -> Path:
        return self.wt_dir / ".base"

    @property
    def state(self) -> Path:
        return self.state_dir if self.state_dir is not None else self.wt_dir / ".state"

    @property
    def default_branch(self) -> str:
        """Local name of the branch the base tracks, e.g. 'main' for 'origin/main'."""
        return self.base_ref.removeprefix(f"{REMOTE}/")

    def mount_point(self, name: str) -> Path:
        return self.wt_dir / name

    def worktree_state(self, name: str) -> Path:
        return self.state / name

    def upper_dir(self, name: str) -> Path:
        return self.worktree_state(name) / "upper"

    def work_dir(self, name: str) -> Path:
        return self.worktree_state(name) / "work"


def parse_overlay_mounts(proc_mounts_text: str) -> set[Path]:
    """Mount points of overlay filesystems, from /proc/self/mounts content."""
    found: set[Path] = set()
    for line in proc_mounts_text.splitlines():
        parts = line.split()
        if len(parts) >= 3 and parts[2] == "overlay":
            # /proc/mounts octal-escapes spaces as \040; branch names never contain them.
            found.add(Path(parts[1]))
    return found


def worktree_names_from_state(state_dir: Path) -> list[str]:
    """Names (possibly nested, like 'a/b') of every state dir holding an upper/."""
    if not state_dir.is_dir():
        return []
    names: list[str] = []

    def walk(d: Path) -> None:
        if (d / "upper").is_dir():
            names.append(str(d.relative_to(state_dir)))
            return
        for child in d.iterdir():
            if child.is_dir() and child.name not in ("upper", "work"):
                walk(child)

    for child in state_dir.iterdir():
        if child.is_dir():
            walk(child)
    return sorted(names)


def parse_wt_config(z_output: str) -> dict[str, list[str]]:
    """Values per lowercased key from `git config -z --get-regexp` output.

    Each value is split into lines and blank lines are dropped, matching how
    `git config --get-all` output is read.
    """
    config: dict[str, list[str]] = {}
    for entry in z_output.split("\0"):
        if entry:
            key, _, value = entry.partition("\n")
            config.setdefault(key, []).extend(line for line in value.splitlines() if line.strip())
    return config


def parse_fuser_pids(stdout: str, ignore: set[int] = frozenset()) -> list[int]:
    """PIDs from `fuser -m` stdout (space-separated, possibly with access-letter suffixes)."""
    pids: list[int] = []
    for token in stdout.split():
        digits = token.rstrip("cefFrm")
        if digits.isdigit() and int(digits) not in ignore:
            pids.append(int(digits))
    return pids


def fs_type_supports_upperdir(fs_type: str) -> bool:
    """overlayfs refuses an overlay (or a few other stacking filesystems) as upperdir."""
    return fs_type.strip().lower() not in ("overlay", "overlayfs", "fuse", "fuseblk", "nfs", "nfs4")


def classify_merge(branch_is_ancestor_of_main: bool, main_is_ancestor_of_branch: bool) -> str:
    """How to bring the base ref into a branch: 'up-to-date', 'fast-forward', or 'merge'."""
    if main_is_ancestor_of_branch:
        return "up-to-date"
    if branch_is_ancestor_of_main:
        return "fast-forward"
    return "merge"


def human_age(seconds: float) -> str:
    if seconds < 3600:
        return f"{int(seconds // 60)}m"
    if seconds < 86400:
        return f"{seconds / 3600:.1f}h"
    return f"{seconds / 86400:.1f}d"


def human_bytes(n: int) -> str:
    size = float(n)
    for unit in ("B", "K", "M", "G"):
        if size < 1024:
            return f"{size:.0f}{unit}" if unit in ("B", "K") else f"{size:.1f}{unit}"
        size /= 1024
    return f"{size:.1f}T"


# ------------------------------------------------------------------------ effects


def log(msg: str) -> None:
    print(f"wt: {msg}", file=sys.stderr, flush=True)


def run(
    cmd: list[str],
    *,
    cwd: Path | None = None,
    check: bool = True,
    capture: bool = True,
) -> subprocess.CompletedProcess[str]:
    # Streamed child output goes to stderr so stdout stays clean for --json.
    proc = subprocess.run(
        cmd,
        cwd=str(cwd) if cwd else None,
        text=True,
        capture_output=capture,
        stdout=None if capture else sys.stderr,
    )
    if check and proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip() if capture else ""
        raise WtError(f"command failed ({proc.returncode}): {' '.join(cmd)}\n{detail}")
    return proc


def sudo(cmd: list[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
    proc = run(["sudo", "-n", *cmd], check=False)
    # Some hosts print a harmless hostname-resolution warning on every sudo call.
    proc.stderr = "\n".join(
        line for line in proc.stderr.splitlines() if "unable to resolve host" not in line
    )
    if check and proc.returncode != 0:
        raise WtError(f"sudo command failed ({proc.returncode}): {' '.join(cmd)}\n{proc.stderr}")
    return proc


def git(args: list[str], cwd: Path, *, check: bool = True) -> str:
    return run(["git", *args], cwd=cwd, check=check).stdout.strip()


def git_ok(args: list[str], cwd: Path) -> bool:
    return run(["git", *args], cwd=cwd, check=False).returncode == 0


def read_wt_config(root: Path) -> dict[str, list[str]]:
    proc = run(["git", "config", "-z", "--get-regexp", r"^wt\."], cwd=root, check=False)
    return parse_wt_config(proc.stdout) if proc.returncode == 0 else {}


def current_branch(path: Path) -> str:
    """Checked-out branch name, or '' when HEAD is detached."""
    return git(["branch", "--show-current"], path)


def dirty(path: Path) -> str:
    """Porcelain status including untracked files; '' when clean."""
    return git(["status", "--porcelain"], path)


def tracked_dirty(path: Path) -> str:
    """Porcelain status of tracked files only (untracked files don't block a checkout)."""
    return git(["status", "--porcelain", "-uno"], path)


def resolve_repo(start: Path) -> Repo:
    """The main checkout owning `start`, even from inside a worktree or the base."""
    proc = run(
        ["git", "-C", str(start), "rev-parse", "--path-format=absolute", "--git-common-dir"],
        check=False,
    )
    if proc.returncode != 0:
        raise WtError(f"not inside a git repository: {start}")
    common = Path(proc.stdout.strip())
    root = common.parent
    if common.name != ".git" or not (root / ".git").is_dir():
        raise WtError(f"unsupported repository layout (bare or detached .git dir): {common}")
    config = read_wt_config(root)

    def first(key: str) -> str | None:
        values = config.get(key)
        return values[0] if values else None

    base_ref = first("wt.baseref")
    if not base_ref:
        head = git(["symbolic-ref", "-q", "--short", f"refs/remotes/{REMOTE}/HEAD"], root, check=False)
        if not head:
            raise WtError(
                f"cannot determine the default branch: {REMOTE}/HEAD is unset.\n"
                f"Run `git remote set-head {REMOTE} -a` or `git config wt.baseRef {REMOTE}/<branch>`."
            )
        base_ref = head
    state_dir = first("wt.statedir")
    return Repo(
        root=root,
        warm=config.get("wt.warm", []),
        base_ref=base_ref,
        cache_paths=[Path(p).expanduser() for p in config.get("wt.cachepath", [])],
        state_dir=Path(state_dir).expanduser().resolve() if state_dir else None,
    )


def require_state_filesystem(repo: Repo) -> None:
    """Fail early, with the fix, when upper/work would land on a filesystem overlayfs rejects."""
    probe = repo.state
    while not probe.exists():
        probe = probe.parent
    fs_type = run(["stat", "-f", "-c", "%T", str(probe)]).stdout.strip()
    if not fs_type_supports_upperdir(fs_type):
        raise WtError(
            f"{repo.state} is on a {fs_type} filesystem, which overlayfs cannot use for upper/work dirs.\n"
            f"Point wt.stateDir at a directory on a regular filesystem, e.g.\n"
            f"  git -C {repo.root} config --local wt.stateDir /workspaces/.wt-state/{repo.root.name}"
        )


def validate_name(repo: Repo, name: str) -> None:
    if not name or name.startswith(".") or name.endswith("/") or "//" in name:
        raise WtError(f"invalid worktree name {name!r}")
    if not git_ok(["check-ref-format", "--branch", name], repo.root):
        raise WtError(f"invalid worktree name {name!r}: must be a valid branch name")


def overlay_mounts() -> set[Path]:
    return parse_overlay_mounts(Path("/proc/self/mounts").read_text())


def is_mounted(repo: Repo, name: str) -> bool:
    return repo.mount_point(name) in overlay_mounts()


def du_bytes(path: Path) -> int:
    if not path.exists():
        return 0
    out = sudo(["du", "-sb", str(path)]).stdout.split()
    return int(out[0]) if out else 0


def busy_pids(repo: Repo, name: str) -> list[int]:
    """PIDs holding the mount, excluding wt itself and its parent.

    `fuser -m` exits 0 and lists a pseudo-entry for the mount itself even when no
    process uses it, so decide on real PIDs from stdout rather than the exit code.
    """
    proc = sudo(["fuser", "-m", str(repo.mount_point(name))], check=False)
    return parse_fuser_pids(proc.stdout or "", ignore={os.getpid(), os.getppid()})


def busy_processes(repo: Repo, name: str) -> str:
    """Human-readable list of processes holding the mount, or '' if none."""
    pids = busy_pids(repo, name)
    if not pids:
        return ""
    verbose = sudo(["fuser", "-vm", str(repo.mount_point(name))], check=False)
    rows = [
        line
        for line in (verbose.stderr or verbose.stdout).splitlines()
        if line.strip() and " mount " not in f" {line} " and not line.startswith("USER")
    ]
    return "\n".join(rows) or f"pids: {' '.join(map(str, pids))}"


def busy_error(name: str, busy: str) -> str:
    return (
        f"worktree {name!r} is busy: these processes have files or their cwd inside it.\n"
        f"Git helpers spawned by a commit or checkout (gc --auto, hooks) finish on their own,\n"
        f"usually within seconds, up to a minute on a large repo: if that is what you see,\n"
        f"retry shortly; otherwise stop them first.\n{busy}"
    )


def require_quiet(repo: Repo, name: str) -> None:
    busy = busy_processes(repo, name)
    if busy:
        raise WtError(busy_error(name, busy))


def require_committed(name: str, mnt: Path, force: bool) -> str:
    """The worktree's porcelain status; refuses when it is dirty unless forced."""
    changes = dirty(mnt)
    if changes and not force:
        raise WtError(f"worktree {name!r} has uncommitted changes; commit them or pass --force to discard:\n{changes}")
    return changes


def require_clean_main(repo: Repo) -> None:
    changes = tracked_dirty(repo.root)
    if changes:
        raise WtError(f"main checkout has uncommitted changes; commit or stash them first:\n{changes}")


def require_new(repo: Repo, name: str) -> None:
    if repo.worktree_state(name).exists() or repo.mount_point(name).exists():
        raise WtError(f"worktree {name!r} already exists")


def existing_name(repo: Repo, raw: str) -> str:
    """Normalize a worktree name from the command line and require its state to exist."""
    name = raw.strip("/")
    if not repo.worktree_state(name).exists():
        raise WtError(f"no worktree named {name!r}")
    return name


def require_environment() -> None:
    if sys.platform != "linux":
        raise WtError("wt needs Linux overlayfs; there is no equivalent on this platform")
    if sudo(["true"], check=False).returncode != 0:
        raise WtError("passwordless sudo is required for overlay mounts")


def has_base(repo: Repo) -> bool:
    return (repo.base / ".git").exists()


def require_base(repo: Repo) -> None:
    if not has_base(repo):
        raise WtError(f"no base at {repo.base}; run `wt base-init` first")


def base_commit(repo: Repo) -> str:
    return git(["rev-parse", "HEAD"], repo.base)


def base_head(repo: Repo) -> tuple[str, float]:
    """The base's HEAD commit and its age in seconds."""
    commit, timestamp = git(["log", "-1", "--format=%H %ct"], repo.base).split()
    return commit, time.time() - int(timestamp)


def mount_overlay(repo: Repo, name: str) -> None:
    mnt, upper, work = repo.mount_point(name), repo.upper_dir(name), repo.work_dir(name)
    for d in (mnt, upper, work):
        d.mkdir(parents=True, exist_ok=True)
    opts = f"lowerdir={repo.base},upperdir={upper},workdir={work}"
    sudo(["mount", "-t", "overlay", "overlay", "-o", opts, str(mnt)])


def unmount_overlay(repo: Repo, name: str) -> None:
    sudo(["umount", str(repo.mount_point(name))])


def heal_mounts(repo: Repo) -> list[str]:
    """Remount any worktree whose state exists but whose overlay is gone (machine restart)."""
    if not has_base(repo):
        return []
    mounted = overlay_mounts()
    healed = [n for n in worktree_names_from_state(repo.state) if repo.mount_point(n) not in mounted]
    for name in healed:
        mount_overlay(repo, name)
    if healed:
        log(f"remounted: {', '.join(healed)}")
    return healed


def worktree_entry(repo: Repo, name: str) -> Path | None:
    """The .git/worktrees/<entry> dir whose gitdir points at this mount, if registered."""
    target = str(repo.mount_point(name) / ".git")
    entries = repo.root / ".git" / "worktrees"
    if not entries.is_dir():
        return None
    for entry in entries.iterdir():
        gitdir_file = entry / "gitdir"
        if gitdir_file.is_file() and gitdir_file.read_text().strip() == target:
            return entry
    return None


def register_worktree_entry(repo: Repo, name: str, commit: str) -> None:
    """Point the overlay's `.git` at a fresh entry under <repo>/.git/worktrees/.

    `git worktree add` refuses a non-empty directory, so the entry is created at a
    temporary path named after the branch's last component and then both pointers
    are rewritten to the mount point. Rewriting `.git` is the only copy-up.
    """
    mnt = repo.mount_point(name)
    git(["worktree", "prune"], repo.root)
    reg_parent = repo.worktree_state(name) / "reg"
    reg_tmp = reg_parent / Path(name).name
    reg_parent.mkdir(parents=True, exist_ok=True)
    git(["worktree", "add", "--no-checkout", "--detach", str(reg_tmp), commit], repo.root)
    pointer = (reg_tmp / ".git").read_text().strip()
    if not pointer.startswith("gitdir: "):
        raise WtError(f"unexpected .git pointer in {reg_tmp}: {pointer!r}")
    gitdir = Path(pointer.removeprefix("gitdir: "))
    shutil.rmtree(reg_parent)
    write_git_pointer(repo, name, gitdir)
    (gitdir / "gitdir").write_text(f"{mnt / '.git'}\n")


def write_git_pointer(repo: Repo, name: str, entry: Path) -> None:
    (repo.mount_point(name) / ".git").write_text(f"gitdir: {entry}\n")


def restore_pointer(repo: Repo, name: str) -> None:
    """Re-create the overlay's `.git` file for an already-registered worktree entry."""
    entry = worktree_entry(repo, name)
    if entry is None:
        raise WtError(f"git worktree entry missing for {name!r}")
    write_git_pointer(repo, name, entry)


def drop_upper(repo: Repo, name: str) -> None:
    """Drop a worktree's diff layer; everything committed lives in the shared .git.

    mount_overlay recreates the empty upper/work dirs.
    """
    sudo(["rm", "-rf", str(repo.upper_dir(name)), str(repo.work_dir(name))])


def destroy(repo: Repo, name: str) -> None:
    if is_mounted(repo, name):
        unmount_overlay(repo, name)
    state, mnt = repo.worktree_state(name), repo.mount_point(name)
    if state.exists():
        # work/ is root-owned by the kernel.
        sudo(["rm", "-rf", str(state)])
    if mnt.exists():
        mnt.rmdir()
    # Drop now-empty parents of nested names, stopping at the .wt dir.
    for parent in (mnt.parent, state.parent):
        while parent not in (repo.wt_dir, repo.state) and parent.is_dir() and not any(parent.iterdir()):
            parent.rmdir()
            parent = parent.parent
    git(["worktree", "prune"], repo.root)


def worktree_status(repo: Repo, name: str) -> dict[str, object]:
    mnt = repo.mount_point(name)
    mounted = is_mounted(repo, name)
    info: dict[str, object] = {"name": name, "path": str(mnt), "mounted": mounted}
    if mounted:
        info["branch"] = current_branch(mnt) or f"detached@{git(['rev-parse', '--short', 'HEAD'], mnt)}"
        info["dirty_files"] = len(dirty(mnt).splitlines())
        info["busy"] = bool(busy_pids(repo, name))
    info["upper_bytes"] = du_bytes(repo.upper_dir(name))
    return info


# --------------------------------------------------------------------- warm / merge


Timings = list[dict[str, object]]


@contextlib.contextmanager
def timed(step: str, timings: Timings):
    log(f"{step}…")
    start = time.monotonic()
    yield
    elapsed = time.monotonic() - start
    timings.append({"step": step, "seconds": round(elapsed, 1)})
    log(f"{step} done in {elapsed:.0f}s")


def fetch(repo: Repo, timings: Timings) -> None:
    with timed(f"fetch {REMOTE}", timings):
        git(["fetch", "-q", REMOTE], repo.root)


def run_warm_commands(repo: Repo, timings: Timings) -> None:
    """Run the repo's configured wt.warm commands in the base, streaming their output."""
    if not repo.warm:
        log("no wt.warm commands configured; base is a plain checkout")
    for cmd in repo.warm:
        with timed(f"warm: {cmd}", timings):
            run(["sh", "-c", cmd], cwd=repo.base, capture=False)


def detach_head(mnt: Path, commit: str) -> None:
    """Point HEAD at a commit without moving the branch it was on and without touching files."""
    git(["update-ref", "--no-deref", "HEAD", commit], mnt)


def merge_base_into_branch(repo: Repo, mnt: Path, branch: str, main_commit: str) -> str:
    """Merge the base ref into `branch` while HEAD is detached at main_commit with a clean tree.

    The merge is computed in the object store first so the final checkout writes
    only the branch's own changes into the overlay. On conflict, fall back to a
    working-tree merge and leave it in progress for a human or agent to resolve.
    Returns the action taken.
    """
    branch_commit = git(["rev-parse", branch], mnt)
    # Unrelated histories exit non-zero with no output, which classifies as a merge.
    common = git(["merge-base", branch_commit, main_commit], mnt, check=False)
    action = classify_merge(common == branch_commit, common == main_commit)
    if action == "fast-forward":
        git(["update-ref", f"refs/heads/{branch}", main_commit, branch_commit], mnt)
    elif action == "merge":
        tree = run(["git", "merge-tree", "--write-tree", branch_commit, main_commit], cwd=mnt, check=False)
        if tree.returncode == 0:
            merged_tree = tree.stdout.strip().splitlines()[0]
            msg = f"Merge {repo.base_ref} into {branch} (wt update)"
            commit = git(["commit-tree", merged_tree, "-p", branch_commit, "-p", main_commit, "-m", msg], mnt)
            git(["update-ref", f"refs/heads/{branch}", commit, branch_commit], mnt)
        elif tree.returncode == 1:
            action = "conflict"
        else:
            raise WtError(f"git merge-tree failed for {branch}:\n{tree.stderr}")
    git(["checkout", "-q", branch], mnt)
    if action == "conflict":
        git(["merge", "--no-edit", main_commit], mnt, check=False)
    return action


# ----------------------------------------------------------------------- commands


def cmd_base_init(repo: Repo, args: argparse.Namespace) -> dict[str, object]:
    require_environment()
    if repo.base.exists():
        raise WtError(f"base already exists at {repo.base}")
    repo.wt_dir.mkdir(parents=True, exist_ok=True)
    # Check now rather than at the first `create`, so a repo on an unsuitable
    # filesystem is caught before a possibly long warm-up.
    require_state_filesystem(repo)
    timings: Timings = []
    fetch(repo, timings)
    with timed(f"git worktree add {repo.base} ({repo.base_ref})", timings):
        git(["worktree", "add", "--detach", str(repo.base), repo.base_ref], repo.root)
    run_warm_commands(repo, timings)
    return {
        "base": str(repo.base),
        "commit": base_commit(repo),
        "base_bytes": du_bytes(repo.base),
        "timings": timings,
    }


def cmd_base_warm(repo: Repo, args: argparse.Namespace) -> dict[str, object]:
    require_environment()
    require_base(repo)
    if overlay_mounts() & {repo.mount_point(n) for n in worktree_names_from_state(repo.state)}:
        # Lower layers must not change under a live overlay.
        raise WtError("worktrees are mounted; remove them before warming the base")
    timings: Timings = []
    run_warm_commands(repo, timings)
    return {"base_bytes": du_bytes(repo.base), "timings": timings}


def cmd_base_remove(repo: Repo, args: argparse.Namespace) -> dict[str, object]:
    require_environment()
    require_base(repo)
    names = worktree_names_from_state(repo.state)
    if names:
        raise WtError(f"remove these worktrees first: {', '.join(names)}")
    if dirty(repo.base) and not args.force:
        raise WtError(f"base {repo.base} has local changes; pass --force to discard")
    git(["worktree", "remove", "--force", str(repo.base)], repo.root)
    for d in (repo.wt_dir, repo.state):
        if d.exists():
            sudo(["rm", "-rf", str(d)])
    return {"removed": str(repo.base)}


def cmd_create(repo: Repo, args: argparse.Namespace) -> dict[str, object]:
    require_environment()
    require_base(repo)
    return create_worktree(repo, args.name, args.start)


def create_worktree(repo: Repo, name: str, start_ref: str | None) -> dict[str, object]:
    """Create a worktree over the base; the caller has checked the environment and base."""
    require_state_filesystem(repo)
    heal_mounts(repo)
    validate_name(repo, name)
    require_new(repo, name)
    commit, age = base_head(repo)
    if age > STALE_BASE_SECONDS:
        log(f"warning: base commit is {human_age(age)} old; consider `wt update`")

    start = time.monotonic()
    mnt = repo.mount_point(name)
    try:
        mount_overlay(repo, name)
        register_worktree_entry(repo, name, commit)
        git(["reset", "-q"], mnt)
        branch_exists = git_ok(["show-ref", "--verify", "-q", f"refs/heads/{name}"], mnt)
        if branch_exists:
            if start_ref:
                raise WtError(f"branch {name} already exists; --from only applies to new branches")
            git(["checkout", "-q", name], mnt)
        else:
            git(["checkout", "-q", "-b", name, start_ref or commit], mnt)
    except Exception:
        destroy(repo, name)
        raise
    info = worktree_status(repo, name)
    info["create_seconds"] = round(time.monotonic() - start, 1)
    info["base_commit"] = commit
    info["created_branch"] = not branch_exists
    return info


def cmd_remove(repo: Repo, args: argparse.Namespace) -> dict[str, object]:
    require_environment()
    heal_mounts(repo)
    name = existing_name(repo, args.name)
    if is_mounted(repo, name):
        require_quiet(repo, name)
        require_committed(name, repo.mount_point(name), args.force)
    destroy(repo, name)
    return {"removed": name}


def cmd_list(repo: Repo, args: argparse.Namespace) -> dict[str, object]:
    require_environment()
    heal_mounts(repo)
    return {"repo": str(repo.root), "worktrees": [worktree_status(repo, n) for n in worktree_names_from_state(repo.state)]}


def cmd_up(repo: Repo, args: argparse.Namespace) -> dict[str, object]:
    require_environment()
    return {"remounted": heal_mounts(repo)}


def cmd_status(repo: Repo, args: argparse.Namespace) -> dict[str, object]:
    require_environment()
    heal_mounts(repo)
    base = None
    if has_base(repo):
        commit, age = base_head(repo)
        base = {"path": str(repo.base), "commit": commit, "age": human_age(age), "bytes": du_bytes(repo.base)}
    return {
        "repo": str(repo.root),
        "base_ref": repo.base_ref,
        "warm": repo.warm,
        "disk_free_bytes": shutil.disk_usage(repo.root).free,
        "caches": [{"path": str(p), "bytes": du_bytes(p)} for p in repo.cache_paths],
        "worktrees": len(worktree_names_from_state(repo.state)),
        "base": base,
    }


def cmd_update(repo: Repo, args: argparse.Namespace) -> dict[str, object]:
    require_environment()
    require_base(repo)
    heal_mounts(repo)
    names = worktree_names_from_state(repo.state)

    problems: list[str] = []
    if dirty(repo.base):
        problems.append(f"base {repo.base} has local changes")
    heads: dict[str, tuple[str | None, str]] = {}
    for name in names:
        mnt = repo.mount_point(name)
        busy = busy_processes(repo, name)
        if busy:
            problems.append(busy_error(name, busy))
        if dirty(mnt):
            problems.append(f"{name}: uncommitted changes")
        branch = current_branch(mnt) or None
        heads[name] = (branch, git(["rev-parse", "HEAD"], mnt))
    if problems:
        raise WtError("update refused:\n" + "\n".join(problems))

    timings: Timings = []
    fetch(repo, timings)
    old_base = base_commit(repo)
    new_base = git(["rev-parse", repo.base_ref], repo.root)

    for name in names:
        unmount_overlay(repo, name)
    results: dict[str, str] = {}
    base_now: str | None = None
    try:
        if new_base != old_base:
            with timed(f"base checkout {new_base[:11]}", timings):
                git(["checkout", "-q", "--detach", new_base], repo.base)
        run_warm_commands(repo, timings)
    finally:
        # Whatever happened to the base, give the worktrees back.
        for name in names:
            branch, head = heads[name]
            mnt = repo.mount_point(name)
            try:
                drop_upper(repo, name)
                mount_overlay(repo, name)
                restore_pointer(repo, name)
                # Read lazily so a failure here is reported per worktree.
                base_now = base_now or base_commit(repo)
                detach_head(mnt, base_now)
                git(["reset", "-q"], mnt)
                if branch is None:
                    git(["checkout", "-q", "--detach", head], mnt)
                    results[name] = "detached (kept)"
                elif args.no_merge:
                    git(["checkout", "-q", branch], mnt)
                    results[name] = "restored (no merge)"
                else:
                    results[name] = merge_base_into_branch(repo, mnt, branch, base_now)
            except WtError as e:
                results[name] = f"FAILED: {e}"
    return {
        "base": {"old": old_base, "new": base_now or base_commit(repo)},
        "worktrees": [{"name": n, "branch": heads[n][0], "result": results[n]} for n in names],
        "timings": timings,
    }


def cmd_promote(repo: Repo, args: argparse.Namespace) -> dict[str, object]:
    require_environment()
    heal_mounts(repo)
    name = existing_name(repo, args.name)
    mnt = repo.mount_point(name)
    require_quiet(repo, name)
    branch = current_branch(mnt)
    if not branch:
        raise WtError(f"worktree {name!r} is detached; nothing to promote")
    if require_committed(name, mnt, args.force):
        git(["reset", "-q", "--hard"], mnt)
        git(["clean", "-fdq"], mnt)
    require_clean_main(repo)
    previous = current_branch(repo.root) or git(["rev-parse", "HEAD"], repo.root)

    git(["checkout", "-q", "--detach"], mnt)
    proc = run(["git", "checkout", "-q", branch], cwd=repo.root, check=False)
    if proc.returncode != 0:
        git(["checkout", "-q", branch], mnt)
        raise WtError(f"could not check out {branch} in {repo.root}:\n{proc.stderr.strip()}")
    destroy(repo, name)
    return {"promoted": name, "branch": branch, "main_was": previous}


def cmd_demote(repo: Repo, args: argparse.Namespace) -> dict[str, object]:
    require_environment()
    require_base(repo)
    heal_mounts(repo)
    branch = current_branch(repo.root)
    if not branch or branch == repo.default_branch:
        raise WtError(f"main checkout must be on a branch other than {repo.default_branch} to demote")
    require_new(repo, branch)
    require_clean_main(repo)

    git(["checkout", "-q", repo.default_branch], repo.root)
    try:
        info = create_worktree(repo, branch, None)
    except Exception:
        git(["checkout", "-q", branch], repo.root)
        raise
    info["demoted"] = branch
    return info


CONFIG_KEYS = {
    "warm": ("wt.warm", True),
    "baseref": ("wt.baseRef", False),
    "cachepath": ("wt.cachePath", True),
    "statedir": ("wt.stateDir", False),
}


def config_key(name: str) -> tuple[str, bool]:
    """Canonical git key and whether it is multi-valued, from a loosely spelled name."""
    entry = CONFIG_KEYS.get(name.lower().removeprefix("wt."))
    if entry is None:
        raise WtError(f"unknown config key {name!r}; one of: {', '.join(v[0] for v in CONFIG_KEYS.values())}")
    return entry


def cmd_config(repo: Repo, args: argparse.Namespace) -> dict[str, object]:
    action = args.action
    if action:
        if not args.key:
            raise WtError(f"config {action} needs a key")
        key, multi = config_key(args.key)
        if action == "unset":
            git(["config", "--local", "--unset-all", key], repo.root, check=False)
        else:
            if not args.values:
                raise WtError(f"config {action} {key} needs a value")
            if not multi and (len(args.values) > 1 or action == "add"):
                raise WtError(f"{key} takes a single value; use `wt config set {args.key} <value>`")
            if action == "set":
                git(["config", "--local", "--unset-all", key], repo.root, check=False)
            for value in args.values:
                git(["config", "--local", "--add", key, value], repo.root)
        repo = resolve_repo(repo.root)
    return {
        "repo": str(repo.root),
        "wt.baseRef": repo.base_ref,
        "wt.warm": repo.warm,
        "wt.cachePath": [str(p) for p in repo.cache_paths],
        "wt.stateDir": str(repo.state) + ("" if repo.state_dir else "  (default)"),
    }


# -------------------------------------------------------------------------- guide


def guide_text(repo: Repo | None) -> str:
    root = str(repo.root) if repo else "<repo>"
    wt_dir = str(repo.wt_dir) if repo else "<repo>.wt"
    base = str(repo.base) if repo else "<repo>.wt/.base"
    ref = repo.base_ref if repo else "origin/<default>"
    return f"""\
wt: overlayfs worktrees for agents

A wt worktree is an overlay mount over a warm base checkout of {ref}. Creating
one takes seconds and costs only the files you change. A plain `git worktree add`
plus dependency install costs a full copy and minutes, and the Agent tool's
`isolation: "worktree"` does the same thing. Never use either in this repo.

THIS REPO
  main checkout   {root}
  worktrees       {wt_dir}/<branch>
  base            {base}   (tracks {ref})
  wt config       prints current config for this repo

COORDINATOR PATTERN
  wt status                    base present? age warning past 24h means run `wt update`
  wt create <branch>           checks the branch out if it exists, else creates it at the
                               base commit (--from <ref> for another start point);
                               prints {wt_dir}/<branch>. Name it per your team's convention.
  -> dispatch a sub-agent WITHOUT worktree isolation; put the path in its prompt
     and include the sub-agent rules below
  wt list                      one line per worktree with busy / dirty flags
  wt remove <branch>           when the worktree is done; refuses if busy or dirty
                               (--force discards uncommitted changes; the branch survives)
  A worktree with uncommitted changes blocks `wt remove` and `wt update` until the
  changes are committed or discarded; how work leaves a worktree (commit, push, or
  hand changes back) is your call together with the operator.

SUB-AGENT RULES (adapt and paste into the sub-agent prompt)
  - Work only inside <path>. Do not touch {root} or {base}.
  - The base is already warmed; run scoped build/test commands normally and skip
    repo-wide setup unless something is stale.
  - Changing dependencies works but copies files instead of sharing them; avoid
    when not needed.

KEEPING CURRENT
  wt update                    every worktree must be quiet and clean. Moves the base
                               to {ref}, re-runs the warm commands, remounts, and
                               merges {ref} into every branch. A conflict is left in
                               place in that worktree: resolve it there, commit, done.
  wt promote <branch>          check the branch out in {root} for human work; removes
                               the worktree. Refuses if either side has changes.
  wt demote                    inverse: move the main checkout's current branch into a worktree
  wt up                        remount after a machine restart (every command self-heals too)

SETUP FOR A NEW REPO
  wt config add warm '<command run in the base after checkout>'   (repeatable)
  wt config set baseRef origin/<branch>        (default: origin's HEAD)
  wt config add cachePath <path>               (sizes shown by `wt status`)
  wt config set stateDir <dir>                 only if the repo sits on an overlay
                                               filesystem (e.g. a container's /home)
  wt base-init                 then `wt config` to review; `wt config unset <key>` to remove

OUTPUT
  Add --json to any command for machine-readable output. Refusals exit 1 with a
  one-line reason on stderr (or {{"error": ...}} with --json).
"""


# ------------------------------------------------------------------------- output


def timing_lines(timings: Timings) -> list[str]:
    return [f"{t['step']}: {t['seconds']}s" for t in timings]


def render(command: str, result: dict[str, object]) -> str:
    if command == "guide":
        return result["guide"].rstrip("\n")
    if command == "list":
        rows = result["worktrees"]
        if not rows:
            return "no worktrees"
        lines = []
        for r in rows:
            flags = []
            if not r["mounted"]:
                flags.append("UNMOUNTED")
            if r.get("busy"):
                flags.append("busy")
            if r.get("dirty_files"):
                flags.append(f"dirty({r['dirty_files']})")
            lines.append(f"{r['name']:<40} {r.get('branch', '-'):<40} {human_bytes(r['upper_bytes']):>8}  {' '.join(flags)}")
        return "\n".join(lines)
    if command in ("create", "demote"):
        verb = "new branch" if result["created_branch"] else "existing branch"
        line = f"{result['path']}  ({verb} {result['branch']}, {result['create_seconds']}s)"
        return line + ("; main checkout is back on its default branch" if command == "demote" else "")
    if command == "remove":
        return f"removed {result['removed']}"
    if command == "base-remove":
        return f"removed base {result['removed']}"
    if command == "up":
        return f"remounted: {', '.join(result['remounted']) or 'nothing to do'}"
    if command == "status":
        base = result["base"]
        lines = [
            f"repo:        {result['repo']}  (base tracks {result['base_ref']})",
            (
                f"base:        {base['path']} @ {base['commit'][:11]} ({base['age']} old, {human_bytes(base['bytes'])})"
                if base
                else "base:        none (run `wt base-init`)"
            ),
            f"worktrees:   {result['worktrees']}",
        ]
        lines += [f"cache:       {c['path']} {human_bytes(c['bytes'])}" for c in result["caches"]]
        lines.append(f"disk free:   {human_bytes(result['disk_free_bytes'])}")
        return "\n".join(lines)
    if command in ("base-init", "base-warm"):
        lines = timing_lines(result["timings"])
        lines.append(f"base size: {human_bytes(result['base_bytes'])}")
        return "\n".join(lines)
    if command == "update":
        b = result["base"]
        lines = [f"base: {b['old'][:11]} -> {b['new'][:11]}" + ("  (unchanged)" if b["old"] == b["new"] else "")]
        lines += timing_lines(result["timings"])
        for w in result["worktrees"]:
            lines.append(f"{w['name']:<40} {w['branch'] or '-':<40} {w['result']}")
        conflicts = [w["name"] for w in result["worktrees"] if w["result"] == "conflict"]
        if conflicts:
            lines.append(f"CONFLICTS left in place, resolve and commit in: {', '.join(conflicts)}")
        return "\n".join(lines)
    if command == "promote":
        return f"promoted {result['promoted']}: main checkout is now on {result['branch']} (was {result['main_was']})"
    if command == "config":
        return "\n".join(
            [
                f"repo:          {result['repo']}",
                f"wt.baseRef:    {result['wt.baseRef']}",
                "wt.warm:       " + (" | ".join(result["wt.warm"]) or "(none)"),
                "wt.cachePath:  " + (", ".join(result["wt.cachePath"]) or "(none)"),
                f"wt.stateDir:   {result['wt.stateDir']}",
            ]
        )
    return json.dumps(result, indent=2)


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="wt", description=__doc__.split("\n\n")[0])
    p.add_argument("--json", action="store_true", help="machine-readable output")
    p.add_argument("--repo", type=Path, help="any path inside the target repo (default: current directory)")
    sub = p.add_subparsers(dest="command", required=True)

    s = sub.add_parser("base-init", help="create the base checkout and run the configured warm commands")
    s.set_defaults(fn=cmd_base_init)
    s = sub.add_parser("base-warm", help="re-run the configured warm commands on the existing base")
    s.set_defaults(fn=cmd_base_warm)
    s = sub.add_parser("base-remove", help="remove the base and the .wt directory (no worktrees may exist)")
    s.add_argument("--force", action="store_true", help="discard local changes in the base")
    s.set_defaults(fn=cmd_base_remove)

    s = sub.add_parser("create", help="create a worktree for a branch over the base (git-only, fast)")
    s.add_argument("name", help="branch name; checked out if it exists, else created")
    s.add_argument("--from", dest="start", metavar="REF", help="start point for a new branch (default: base commit)")
    s.set_defaults(fn=cmd_create)

    s = sub.add_parser("remove", help="unmount and delete a worktree; its branch survives")
    s.add_argument("name")
    s.add_argument("--force", action="store_true", help="discard uncommitted changes")
    s.set_defaults(fn=cmd_remove)

    s = sub.add_parser("list", help="list this repo's worktrees")
    s.set_defaults(fn=cmd_list)
    s = sub.add_parser("status", help="base, caches, disk")
    s.set_defaults(fn=cmd_status)
    s = sub.add_parser(
        "config",
        help="show or change this repo's wt configuration",
        description="wt config                      show\n"
        "wt config set <key> <value>... replace the key's value(s)\n"
        "wt config add <key> <value>    append to a multi-valued key (warm, cachePath)\n"
        "wt config unset <key>          remove the key\n"
        "keys: warm, baseRef, cachePath, stateDir",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    s.add_argument("action", nargs="?", choices=["set", "add", "unset"])
    s.add_argument("key", nargs="?")
    s.add_argument("values", nargs="*")
    s.set_defaults(fn=cmd_config)
    s = sub.add_parser("up", help="remount worktrees after a machine restart")
    s.set_defaults(fn=cmd_up)
    sub.add_parser("guide", help="how agents should use wt (read this first)")

    s = sub.add_parser("update", help="move the base to its ref and merge it into every worktree branch (all must be quiet and clean)")
    s.add_argument("--no-merge", action="store_true", help="restore branches as-is instead of merging")
    s.set_defaults(fn=cmd_update)

    s = sub.add_parser("promote", help="check a worktree's branch out in the main checkout and remove the worktree")
    s.add_argument("name")
    s.add_argument("--force", action="store_true", help="discard the worktree's uncommitted changes")
    s.set_defaults(fn=cmd_promote)
    s = sub.add_parser("demote", help="move the main checkout's current branch into a new worktree")
    s.set_defaults(fn=cmd_demote)
    return p


def main(argv: list[str]) -> int:
    args = build_parser().parse_args(argv)
    try:
        start = (args.repo or Path.cwd()).resolve()
        if args.command == "guide":
            try:
                repo: Repo | None = resolve_repo(start)
            except WtError:
                repo = None
            result: dict[str, object] = {"guide": guide_text(repo)}
        else:
            result = args.fn(resolve_repo(start), args)
    except WtError as e:
        if args.json:
            print(json.dumps({"error": str(e)}))
        else:
            print(f"wt: error: {e}", file=sys.stderr)
        return 1
    print(json.dumps(result, indent=2) if args.json else render(args.command, result))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
